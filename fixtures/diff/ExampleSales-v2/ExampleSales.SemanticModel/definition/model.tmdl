model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ServerName","DatabaseName","Sales","Date","Product","Customer","Store"]

ref table Sales
ref table Date
ref table Product
ref table Customer
ref table Store
ref table 'Time Intelligence'
ref table Promotion

